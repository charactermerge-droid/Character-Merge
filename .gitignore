# ---------------- Unity ----------------
# Generated/derived; Unity rebuilds these from Assets + Packages + ProjectSettings.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Never commit a .meta without its asset, or an asset without its .meta.
# (Both are tracked by default; this file only excludes whole generated folders.)

# Visual Studio / Rider / VS Code project files, regenerated on demand
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D-generated crash/profiler output
sysinfo.txt
*.stackdump
crashlytics-build.properties
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Builds
*.apk
*.aab
*.unitypackage
*.app

# ---------------- Server (Node) ----------------
node_modules/
*.log
npm-debug.log*

# Secrets and machine-local config. .env.example is committed instead.
.env
.env.*
!.env.example
google-sa*.json
*.sa.json

# ---------------- OS ----------------
.DS_Store
Thumbs.db
desktop.ini

# From the GitHub Unity template
.utmp/
*.blend1
*.blend1.meta
.cloudrun-secrets*.json

# Media lives in Supabase Storage. A local copy may exist for STORAGE=local; never commit it.
server/local-storage/
