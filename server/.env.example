# ---- Server ----
PORT=8080
HOST=0.0.0.0
# Public origin the Unity client can reach. Used to build local signed URLs.
# On a phone over LAN, set this to http://<your-pc-lan-ip>:8080
PUBLIC_BASE_URL=http://localhost:8080
ADMIN_SECRET=change-me-to-something-long-and-random
RATE_LIMIT_PER_MINUTE=120

# ---- Content catalog: "local" (CSV files) or "google" (Google Sheet) ----
SHEET_SOURCE=local
SHEET_LOCAL_DIR=./fixtures
SHEET_REFRESH_SECONDS=300
# google only: SHEET_ID is the long id in the sheet URL (docs.google.com/spreadsheets/d/<SHEET_ID>/edit).
# Give the service-account key either as a file path (easiest) or inline JSON.
SHEET_ID=
GOOGLE_SA_JSON_FILE=./google-sa.json
GOOGLE_SA_JSON=

# ---- Asset storage: "supabase" (staging), "local" (disk + HMAC-signed URLs, offline dev) or "azure" ----
STORAGE=local
LOCAL_STORAGE_DIR=./local-storage
# Optional; random per boot if unset (existing signed URLs stop working on restart).
LOCAL_SIGNING_SECRET=
# supabase only: buckets `thumbs` and `merges`, private. Key = the SECRET key (sb_secret_... / service_role).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# azure only:
AZURE_STORAGE_ACCOUNT=
SAS_TTL_MINUTES=60
# Seconds to remember a successful blob-properties lookup (avoids one storage round trip per /merge).
BLOB_PROPS_CACHE_SECONDS=60
